{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kpi_explanation.output.v1",
  "description": "Explanation of KPI changes. Every observation names the metrics it is about; every number in any text must be one of the numbers in the input. With no usable values the output says so instead of inventing content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "headline", "observations", "recommendations", "insufficient_data", "language", "generator"],
  "properties": {
    "schema": { "const": "kpi_explanation.output.v1" },
    "headline": { "type": "string", "minLength": 1, "maxLength": 300 },
    "observations": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_codes", "text"],
        "properties": {
          "metric_codes": { "$ref": "#/$defs/codes" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_codes", "text"],
        "properties": {
          "metric_codes": { "$ref": "#/$defs/codes" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "insufficient_data": {
      "type": "boolean",
      "description": "True when no metric has a non-zero current value; observations and recommendations are then empty."
    },
    "language": { "type": "string", "enum": ["ru", "ky", "en"] },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "is_mock"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "is_mock": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" }
    }
  }
}
