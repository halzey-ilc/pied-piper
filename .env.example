# CRM Platform environment template.
# Copy to `.env` for local development, then fill the secrets:
#   cp .env.example .env && ./scripts/init_env.sh
# NEVER commit a real .env. Secret placeholders below are either empty or the
# literal __GENERATE__, which the application refuses to start with.

# --- Core -------------------------------------------------------------------
DJANGO_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=__GENERATE__
API_DOCS_ENABLED=true

# --- JWT --------------------------------------------------------------------
JWT_SIGNING_KEY=__GENERATE__
JWT_ACCESS_TTL_MINUTES=10
JWT_REFRESH_TTL_HOURS=24

# --- CORS / CSRF (explicit origins only) ------------------------------------
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Control-plane database -------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=crm_control
DB_USER=crm_app
DB_PASSWORD=__GENERATE__
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=0
DB_USE_PGBOUNCER=false
# Optional dedicated CREATEDB provisioning role (production). Falls back to
# DB_USER / DB_PASSWORD when unset. See docs/operations/production-hardening.md.
DB_PROVISION_USER=
DB_PROVISION_PASSWORD=

# Any secret below may instead be supplied from a file by setting <NAME>_FILE to
# a path (e.g. DB_PASSWORD_FILE=/run/secrets/db_password). The file's value is
# used unless <NAME> itself is set. This keeps plaintext out of the environment.

# --- Tenant plane -----------------------------------------------------------
TENANT_DB_PREFIX=crm_tenant_
TENANT_MAX_ACTIVE_ALIASES=32
TENANT_PROVISIONING_ENABLED=false

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# TLS (production): rediss:// with CA verification.
REDIS_USE_TLS=false
REDIS_CA_CERT=
REDIS_CACHE_DB=0
REDIS_RESULTS_DB=1

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=crm
RABBITMQ_PASSWORD=__GENERATE__
RABBITMQ_VHOST=crm
# TLS (production): amqps:// with CA verification. Use port 5671 when enabled.
RABBITMQ_USE_TLS=false
RABBITMQ_CA_CERT=
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
DIAGNOSTIC_TASKS_ENABLED=false

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=crm-platform

# --- Integration webhook secrets (empty = integration disabled) -------------
WHATSAPP_APP_SECRET=
INSTAGRAM_APP_SECRET=
TELEGRAM_WEBHOOK_SECRET=
TELEPHONY_WEBHOOK_SECRET=
