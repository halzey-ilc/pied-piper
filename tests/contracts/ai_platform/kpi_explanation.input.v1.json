{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kpi_explanation.input.v1",
  "description": "KPI values computed by the CRM (SQL / business code) for a period and the period before it, with changes precomputed by the CRM. The model only explains these numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "period", "previous_period", "metrics"],
  "properties": {
    "language": { "type": "string", "enum": ["ru", "ky", "en"] },
    "period": { "$ref": "#/$defs/period" },
    "previous_period": { "$ref": "#/$defs/period" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "unit", "current", "previous", "change", "change_pct"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "unit": { "type": "string", "enum": ["count", "percent", "money"] },
          "current": { "type": ["number", "null"] },
          "previous": { "type": ["number", "null"] },
          "change": { "type": ["number", "null"], "description": "current - previous (percentage points for percent units)" },
          "change_pct": { "type": ["number", "null"], "description": "relative change in %, null when previous is 0 or unknown" }
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "end"],
      "properties": {
        "type": { "type": "string", "enum": ["day", "week", "month"] },
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date", "description": "exclusive" }
      }
    }
  }
}
